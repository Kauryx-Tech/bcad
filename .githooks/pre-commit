#!/usr/bin/env bash
# Vérifications locales rapides. La CI (.github/workflows/ci.yml) fait
# toujours le vrai contrôle build+test — ceci ne fait que rattraper les
# erreurs bon marché avant qu'elles ne soient commitées.
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

status=0

# Marqueurs de conflit de fusion non résolus.
markers=$(grep -lE '^(<{7}|={7}|>{7}) ?' $staged 2>/dev/null || true)
if [ -n "$markers" ]; then
    echo "pre-commit: merge-conflict markers found in:"
    echo "$markers" | sed 's/^/  /'
    status=1
fi

# Les chemins ignorés qui ont été force-ajoutés (artefacts de build, venv,
# fichiers de test isolés) ne devraient pas finir dans un commit.
ignored=$(git diff --cached --name-only --diff-filter=ACM | git check-ignore --stdin || true)
if [ -n "$ignored" ]; then
    echo "pre-commit: staged files matched by .gitignore (force-added?):"
    echo "$ignored" | sed 's/^/  /'
    status=1
fi

# Formatage, uniquement si le fichier de style et l'outil sont tous deux présents.
if [ -f .clang-format ] && command -v clang-format >/dev/null 2>&1; then
    cpp_files=$(echo "$staged" | grep -E '\.(cpp|h|hpp)$' || true)
    if [ -n "$cpp_files" ]; then
        for f in $cpp_files; do
            if ! clang-format --dry-run --Werror "$f" >/dev/null 2>&1; then
                echo "pre-commit: $f is not clang-format clean (run: clang-format -i $f)"
                status=1
            fi
        done
    fi
fi

exit $status
