/* Gabarit de la feuille de style : chaque valeur est un jeton (nom entre deux arobases) du
   design system (src/app/theme/Theme.cpp, docs/DESIGN_SYSTEM.md), remplace
   au chargement. Aucune valeur de couleur en dur ici (check_arch). */
/* Thème sombre de BCAD, dans l'esprit des espaces de travail AutoCAD récents :
   interface neutre gris-bleu, accent bleu unique, pour que les couleurs
   saturées des entités ressortent sur le canevas. Appliqué à l'application
   entière (voir MainWindow::applyDarkTheme) afin que les boîtes de dialogue
   héritent aussi du thème. */

QWidget { color: @text-primary@; font-family: @font-ui@; font-size: @font-body@; }
QMainWindow, QDialog, QStatusBar { background-color: @window@; }
QToolTip { background-color: @surface-sunken@; color: @text-primary@; border: 1px solid @border@; padding: 4px 6px; }

/* --- Barre de menus et menus --- */
QMenuBar { background-color: @toolbar@; border-bottom: 1px solid @surface-sunken@; padding: 1px 4px; }
QMenuBar::item { background: transparent; padding: 4px 10px; border-radius: @radius@; }
QMenuBar::item:selected { background-color: @border@; }
QMenu { background-color: @panel@; border: 1px solid @surface-sunken@; padding: 4px 0; }
QMenu::item { padding: 5px 28px 5px 30px; }
QMenu::item:selected { background-color: @accent@; color: @text-strong@; }
QMenu::item:disabled { color: @text-disabled@; }
QMenu::separator { height: 1px; background: @border@; margin: 4px 8px; }
QMenu::icon { padding-left: 8px; }

/* --- Barre d'accès rapide --- */
QToolBar#quickAccessToolbar { background-color: @toolbar@; border: none; border-bottom: 1px solid @surface-sunken@; spacing: 2px; padding: 2px 6px; }
QToolBar#ribbonToolbar { padding: 0; margin: 0; border: none; spacing: 0; }
QToolBar#quickAccessToolbar QToolButton { background: transparent; border: 1px solid transparent; border-radius: @radius@; padding: 2px; }
QToolBar#quickAccessToolbar QToolButton:hover { background-color: @border@; }
QToolBar#quickAccessToolbar QToolButton:checked { background-color: @accent-soft@; border-color: @accent@; }
#quickAccessCustomize::menu-indicator { image: none; width: 0; }
QToolBar::separator { background: @border@; width: 1px; margin: 4px 4px; }

/* --- Ruban --- */
RibbonBar::pane { border: none; background-color: @ribbon@; border-bottom: 1px solid @surface-sunken@; }
RibbonBar QTabBar { background-color: @toolbar@; }
RibbonBar QTabBar::tab { background: transparent; color: @text-secondary@; padding: 6px 18px; border: none; margin-top: 2px; }
RibbonBar QTabBar::tab:selected { background-color: @ribbon@; color: @text-strong@; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom: 2px solid @accent@; }
RibbonBar QTabBar::tab:hover:!selected { color: @text-strong@; background-color: @panel-alt@; }
#ribbonPage { background-color: @ribbon@; }
#ribbonPanel { background-color: @border-panel@; border: 1px solid @toolbar@; border-radius: @radius@; }
#ribbonPanelCaption { background-color: @caption@; color: @text-caption@; font-size: @font-caption@; padding: 2px 8px; border-top: 1px solid @toolbar@; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
#ribbonLargeButton, #ribbonSmallButton { background: transparent; border: 1px solid transparent; border-radius: @radius@; color: @text-primary@; }
#ribbonLargeButton { padding: 3px 4px 2px 4px; font-size: @font-caption@; }
#ribbonSmallButton { padding: 2px 6px; text-align: left; }
#ribbonLargeButton:hover, #ribbonSmallButton:hover { background-color: @control-hover@; border-color: @border-hover@; }
#ribbonLargeButton:pressed, #ribbonSmallButton:pressed { background-color: @toolbar@; }
#ribbonLargeButton:checked, #ribbonSmallButton:checked { background-color: @accent-soft@; border-color: @accent@; }
#ribbonLargeButton:disabled, #ribbonSmallButton:disabled { color: @text-disabled@; }
/* Boutons deroulants (Ajuster ▾, Cercle ▾…) : partie fleche discrete, comme AutoCAD. */
#ribbonLargeButton[popupMode="1"] { padding-right: 14px; }
#ribbonSmallButton[popupMode="1"] { padding-right: 16px; }
#ribbonLargeButton::menu-button, #ribbonSmallButton::menu-button { background: transparent; border: none; border-left: 1px solid transparent; width: 13px; }
#ribbonLargeButton::menu-button:hover, #ribbonSmallButton::menu-button:hover { background-color: @control-hover@; border-left-color: @border-hover@; }
#ribbonLargeButton::menu-arrow, #ribbonSmallButton::menu-arrow { image: url(:/icons/chevron-down.svg); width: 9px; height: 9px; }
#ribbonLargeButton::menu-indicator, #ribbonSmallButton::menu-indicator { image: url(:/icons/chevron-down.svg); subcontrol-position: bottom right; width: 9px; height: 9px; }
/* Fleche du panneau etendu, a droite du titre. */
#ribbonPanelExpand { background-color: @caption@; border: none; border-top: 1px solid @toolbar@; padding: 0 3px; }
#ribbonPanelExpand:hover { background-color: @control-hover@; }
#ribbonPanelExpand::menu-indicator { image: none; width: 0; }
#ribbonAppButton { background-color: transparent; border: none; padding: 3px 8px; margin: 0 4px; }
#ribbonAppButton:hover { background-color: @border@; border-radius: @radius@; }
#ribbonAppButton::menu-indicator { image: none; width: 0; }

/* --- Panneaux ancrés --- */
QDockWidget { color: @text-dock@; }
QDockWidget::title { background-color: @toolbar@; padding: 6px 8px; border-bottom: 1px solid @surface-sunken@; }
QDockWidget > QWidget { background-color: @panel@; }
QTabBar::tab { background-color: @toolbar@; color: @text-secondary@; padding: 5px 12px; border: none; }
QTabBar::tab:selected { background-color: @panel@; color: @text-strong@; border-top: 2px solid @accent@; }
QTabBar::tab:hover:!selected { color: @text-strong@; }

QTreeWidget, QTreeView, QListView, QTableView, QTableWidget {
    background-color: @panel@; alternate-background-color: @panel-alt@; color: @text-primary@;
    border: none; selection-background-color: @accent@; selection-color: @text-strong@; }
QTreeWidget::item, QTableWidget::item { padding: 2px; }
QTreeWidget::item:hover, QTableWidget::item:hover { background-color: @control@; }
QHeaderView::section { background-color: @toolbar@; color: @text-caption@; border: none; border-right: 1px solid @surface-sunken@; padding: 4px 6px; }

/* --- Contrôles de formulaire --- */
QPushButton { background-color: @control@; color: @text-primary@; border: 1px solid @control-raised@; border-radius: @radius@; padding: 5px 14px; }
QPushButton:hover { background-color: @control-hover@; border-color: @control-raised-hover@; }
QPushButton:pressed { background-color: @toolbar@; }
QPushButton:default { border-color: @accent@; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: @field@; color: @text-primary@; border: 1px solid @border@; border-radius: @radius@;
    padding: 3px 6px; selection-background-color: @accent@; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: @accent@; }
QComboBox QAbstractItemView { background-color: @panel@; border: 1px solid @surface-sunken@; selection-background-color: @accent@; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid @border-hover@; border-radius: @radius-small@; background: @field@; }
QCheckBox::indicator:checked { background-color: @accent@; border-color: @accent@; }

QScrollBar:vertical { background: @scroll-track@; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @control-raised@; min-height: 24px; border-radius: @radius-round@; margin: 2px; }
QScrollBar:horizontal { background: @scroll-track@; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: @control-raised@; min-width: 24px; border-radius: @radius-round@; margin: 2px; }
QScrollBar::handle:hover { background: @control-raised-hover@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* --- Ligne de commande (sous le canevas, comme AutoCAD) --- */
#commandBar { background-color: @toolbar@; border-top: 1px solid @surface-sunken@; }
#commandPrompt { color: @accent@; font-weight: bold; padding: 0 2px 0 8px; }
#commandBar QLineEdit { background-color: @field@; border: 1px solid @border@; border-radius: @radius@; padding: 4px 8px; font-family: @font-mono@; }
#commandBar QLineEdit:focus { border-color: @accent@; }

/* --- Barre d'état --- */
QStatusBar { border-top: 1px solid @surface-sunken@; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: @text-secondary@; padding: 0 10px; }
QStatusBar QToolButton { background: transparent; border: 1px solid transparent; border-radius: @radius@; padding: 1px; margin: 1px; }
QStatusBar QToolButton:hover { background-color: @border@; }
QStatusBar QToolButton:checked { background-color: @accent-soft@; border-color: @accent@; }
#ribbonScroll, #ribbonScroll > QWidget > QWidget { background-color: @ribbon@; border: none; }

/* --- Onglets des dessins ouverts (entre le ruban et le canevas) --- */
#documentTabsStrip { background-color: @toolbar@; border-bottom: 1px solid @surface-sunken@; }
#documentTabs::tab { background-color: @toolbar@; color: @text-secondary@; padding: 5px 10px 5px 14px; margin-right: 1px; border: none; border-top: 2px solid transparent; min-width: 90px; }
#documentTabs::tab:selected { background-color: @canvas@; color: @text-strong@; border-top: 2px solid @accent@; }
#documentTabs::tab:hover:!selected { background-color: @ribbon@; color: @text-strong@; }
#documentNewTab { color: @text-secondary@; font-size: @font-glyph@; padding: 0 8px; border: none; }
#documentNewTab:hover { color: @text-strong@; background-color: @border@; border-radius: @radius@; }
#statusSeparator { color: @border@; margin: 4px 3px; }
