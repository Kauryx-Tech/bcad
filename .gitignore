.vscode/
.idea/
*.swp

# OS cruft
.DS_Store

# Stray local/test artifacts
New Folder/
*.bcad
# Les fixtures de tests de compatibilite .bcad sont des attendu de test, pas des
# dessins de travail : sans cette exception, `git add` les ignore en silence et
# un clone frais echoue faute de fichier.
!tests/fixtures/bcad/*.bcad
# ... mais leurs annexes WAL (-shm/-wal, recréées par toute ouverture SQLite,
# même en lecture seule sur un fichier en mode WAL) ne sont jamais des sources.
*.bcad-shm
*.bcad-wal

# Editor local history & scratch files
.history/
meme.py

# Rust build output (833 Mo de derives, jamais une source)
rust/target/

# Outil local : permissions et historique de commandes, propre a la machine
.qoder/
