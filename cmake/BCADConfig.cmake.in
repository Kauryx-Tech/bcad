# BCADConfig.cmake - Configuration file for BCAD SDK
# Generated by configure_package_config_file() and installed with the SDK.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies (Core SDK dependencies)
find_dependency(CGAL REQUIRED)
find_dependency(OpenGL REQUIRED)
find_dependency(SQLite3 REQUIRED)
find_dependency(Threads REQUIRED)

# Qt6 is optional - only required for the app module
find_dependency(Qt6 QUIET COMPONENTS Widgets OpenGLWidgets OpenGL Gui)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/BCADTargets.cmake")

# Provide convenience variables
set_and_check(BCAD_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(BCAD_LIBRARY_DIRS "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

# Provide imported targets for each module
# Usage: target_link_libraries(your_target PRIVATE BCAD::bcad_geometry BCAD::bcad_core ...)
# (les targets importes portent le nom des bibliotheques, prefixe BCAD::)
# For the app module, also link BCAD::bcad_app and find Qt6